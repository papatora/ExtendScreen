<Window x:Class="AzurateMirror.Sender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AzurateMirror.Sender"
        mc:Ignorable="d"
        Title="AzurateMirror V2" Height="560" Width="700" Background="#12161C" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnStart" Content="Start" Width="90" Click="BtnStart_Click"/>
            <Button x:Name="BtnStop" Content="Stop" Width="90" Margin="8,0,0,0" Click="BtnStop_Click" IsEnabled="False"/>
            <TextBlock x:Name="TxtStatus" Text="Stopped" Foreground="#4FC3F7" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14"/>
            <CheckBox x:Name="ChkCloseToTray" Content="Minimize to tray on close (X)" Foreground="#CCC"
                      VerticalAlignment="Center" Margin="24,0,0,0" Checked="ChkCloseToTray_Changed" Unchecked="ChkCloseToTray_Changed"/>
            <TextBlock x:Name="TxtTransport" Text="" Foreground="#FFA726" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"
                       ToolTip="Actual transport is decided by which IP the tablet dials (127.0.0.1 = USB, real IP = WiFi) - this is just a live indicator of what happened, not a picker."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Connect via:" Foreground="#CCC" VerticalAlignment="Center"/>
            <RadioButton x:Name="RbUsb" Content="USB (auto adb reverse)" Foreground="#CCC" IsChecked="True"
                         VerticalAlignment="Center" Margin="10,0,0,0" GroupName="TransportMode"/>
            <RadioButton x:Name="RbWifi" Content="WiFi (LAN)" Foreground="#CCC"
                         VerticalAlignment="Center" Margin="16,0,0,0" GroupName="TransportMode"/>
            <CheckBox x:Name="ChkEnableTouchpad" Content="Enable touchpad relay (let tablet control this PC's mouse)"
                      Foreground="#CCC" VerticalAlignment="Center" Margin="24,0,0,0"
                      Checked="ChkEnableTouchpad_Changed" Unchecked="ChkEnableTouchpad_Changed"
                      ToolTip="Second gate on top of the tablet's own 'Enable touchpad' checkbox - both sides must agree before touch input is accepted. Off by default."/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="TxtPortInfo" Text="Port: 47632" Foreground="#888" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <Border Grid.Row="3" Background="#1E2530" BorderBrush="#4FC3F7" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <Expander x:Name="ExpImportantNote" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="IMPORTANT NOTE — read before connecting (click to expand/hide)" Foreground="#4FC3F7" FontWeight="Bold"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                <TextBlock Foreground="#CCC" TextWrapping="Wrap" FontSize="12" LineHeight="19">
                    <Run Text="1. One-time: if a Windows Firewall popup appears the first time you click Start, click &quot;Allow access&quot; but only tick the "/>
                    <Run Text="Private" FontWeight="Bold"/>
                    <Run Text=" network box (leave Public unchecked)."/>
                    <LineBreak/>
                    <Run Text="2. USB mode (recommended, default): plug the tablet in with a data cable, enable USB debugging on it, pick &quot;USB&quot; above, then Start. This app runs "/>
                    <Run Text="adb reverse" FontFamily="Consolas"/>
                    <Run Text=" for you automatically - on the tablet's Connect screen just leave the IP field as "/>
                    <Run Text="127.0.0.1" FontFamily="Consolas" FontWeight="Bold"/>
                    <Run Text=". No WiFi, no IP typing, no firewall exposure."/>
                    <LineBreak/>
                    <Run Text="3. WiFi mode: pick &quot;WiFi&quot; above and Start - this PC's LAN IP is shown below (Port line). On the tablet's Connect screen, type that exact IP into the host field, port stays "/>
                    <Run Text="47632" FontFamily="Consolas" FontWeight="Bold"/>
                    <Run Text=". Both devices must be on the same network, and this PC's WiFi must be set to "/>
                    <Run Text="Private" FontWeight="Bold"/>
                    <Run Text=" (Settings &gt; Network &amp; internet &gt; Wi-Fi &gt; network name &gt; Network profile type) - if it's Public, the tablet will just time out."/>
                    <LineBreak/>
                    <Run Text="4. Extend (default, picked on the tablet) = the tablet becomes a real second Windows monitor (&quot;VDD by MTT&quot;) - drag any app onto it and it disappears from this PC's screen. Mirror = shows this PC's whole main screen instead."/>
                    <LineBreak/>
                    <Run Text="5. Touchpad relay (optional) needs BOTH the checkbox here AND the one on the tablet's Connect screen checked before touches on the tablet move this PC's mouse - either side can veto it."/>
                    <LineBreak/>
                    <Run Text="6. If the virtual monitor isn't detected: check Device Manager for &quot;VDD by MTT&quot; under Display adapters/monitors."/>
                </TextBlock>
                </StackPanel>
            </Expander>
        </Border>

        <RichTextBox x:Name="TxtLog" Grid.Row="4" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Background="#1E2530" Foreground="#DDD" BorderThickness="0">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>
    </Grid>
</Window>
