<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AzurateMirror.Sender</AssemblyName>
    <RootNamespace>AzurateMirror.Sender</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- Manifest-level DPI awareness, applied by Windows before any process code runs - the
         App.OnStartup runtime call (SetProcessDpiAwarenessContext) that used to be the only
         DPI-awareness declaration here was race-prone: if any window/DPI-touching API ran during
         WPF's own internal startup before OnStartup's user code executed, the runtime call would
         silently fail to take effect, causing GDI resolution reads (FindVirtualOutput) to be
         virtualized on some launches and not others - exactly the kind of inconsistent black-
         screen-on-connect behavior this was chasing. This SDK property bakes PerMonitorV2 into
         the generated manifest instead, which Windows honors unconditionally from process start. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.2.3</Version>
    <AssemblyVersion>0.2.3.0</AssemblyVersion>
    <FileVersion>0.2.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored adb (USB-mode "adb reverse" setup - see Network/AdbBridge.cs) so end users don't
         need Android platform-tools installed separately. -->
    <None Include="..\..\tools\adb\adb.exe" CopyToOutputDirectory="PreserveNewest" Link="tools\adb\adb.exe" />
    <None Include="..\..\tools\adb\AdbWinApi.dll" CopyToOutputDirectory="PreserveNewest" Link="tools\adb\AdbWinApi.dll" />
    <None Include="..\..\tools\adb\AdbWinUsbApi.dll" CopyToOutputDirectory="PreserveNewest" Link="tools\adb\AdbWinUsbApi.dll" />
  </ItemGroup>

</Project>
