<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AzurateMirror.Sender</AssemblyName>
    <RootNamespace>AzurateMirror.Sender</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- ApplicationHighDpiMode was tried here first and turned out to be a no-op for this
         project: that property only takes effect via a WinForms-generated Main(), but this
         app's actual entry point is WPF-generated (UseWPF wins entry-point generation over
         UseWindowsForms, which here is only for the tray icon's NotifyIcon) - confirmed no
         manifest was ever produced under obj/ with it set. app.manifest (referenced below) is
         the mechanism that's actually correct for a WPF app: Windows applies dpiAwareness from
         the embedded manifest at process creation, before any managed code runs. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.3</Version>
    <AssemblyVersion>0.2.3.0</AssemblyVersion>
    <FileVersion>0.2.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vendored adb (USB-mode "adb reverse" setup - see Network/AdbBridge.cs) so end users don't
         need Android platform-tools installed separately. -->
    <None Include="..\..\tools\adb\adb.exe" CopyToOutputDirectory="PreserveNewest" Link="tools\adb\adb.exe" />
    <None Include="..\..\tools\adb\AdbWinApi.dll" CopyToOutputDirectory="PreserveNewest" Link="tools\adb\AdbWinApi.dll" />
    <None Include="..\..\tools\adb\AdbWinUsbApi.dll" CopyToOutputDirectory="PreserveNewest" Link="tools\adb\AdbWinUsbApi.dll" />
  </ItemGroup>

</Project>
